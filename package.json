{
  "name": "probe-3d",
  "version": "0.1.1",
  "main": "index",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools",
    "lint": "expo lint src App.tsx index.ts --max-warnings 0",
    "test": "bun test tools/test",
    "export:web": "setup-skia-web public && expo export --platform web --output-dir dist-web",
    "e2e": "bun tools/e2e/web.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.21",
    "expo-file-system": "~57.0.7",
    "expo-gl": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "fast-text-encoding": "1.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0",
    "react-native-webgpu": "0.21.1",
    "react-native-worklets": "0.10.1",
    "three": "0.184.0"
  },
  "trustedDependencies": [
    "@shopify/react-native-skia"
  ],
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/three": "0.184.0",
    "bun-types": "^1.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "playwright": "1.56.1",
    "typescript": "~6.0.3"
  }
